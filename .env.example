# FOR LOCAL DEVELOPMENT ONLY. Replace every value before using outside localhost.
DATABASE_URL=postgresql+psycopg://app:local-password@localhost:5432/enterprise
POSTGRES_PASSWORD=local-password
JWT_SECRET_KEY=dev-only-replace-this-with-a-long-random-32-byte-secret
BOOTSTRAP_KEY=dev-only-bootstrap-replace-with-a-long-random-secret
ENVIRONMENT=development

# Redis rate limiting
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
